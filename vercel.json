{
  "redirects": [
    {
      "source": "/prompticon",
      "destination": "/prompticon/",
      "permanent": true
    },
    {
      "source": "/quicklinks",
      "destination": "/quicklinks/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "naveenkumar.xyz"
        }
      ],
      "destination": "https://dosa.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.naveenkumar.xyz"
        }
      ],
      "destination": "https://dosa.dev/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/prompticon/",
      "destination": "https://prompticon-site.vercel.app/"
    },
    {
      "source": "/prompticon/:path*",
      "destination": "https://prompticon-site.vercel.app/:path*"
    },
    {
      "source": "/quicklinks/",
      "destination": "https://quick-links-lemon.vercel.app/"
    },
    {
      "source": "/quicklinks/:path*",
      "destination": "https://quick-links-lemon.vercel.app/:path*"
    }
  ]
}
